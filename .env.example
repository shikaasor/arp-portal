# Local settings for both the website (frontend/) and the API (backend/).
# Copy to `.env.local` in the repo root:   cp .env.example .env.local
# Or pull the Vercel project's values:      vercel env pull .env.local
# Values already set in the environment (e.g. on Vercel or in CI) win over this file.

# --- Supabase: Project Settings → Data API (URL) and → API Keys (keys) ---
# Used by both apps. The API reads this too, so SUPABASE_URL is only needed if it differs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Secret key (sb_secret_…) or legacy service_role key. API only — SECRET, never commit,
# never give it a NEXT_PUBLIC_ name (only NEXT_PUBLIC_* values reach browser code).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=applicant-documents

# --- Local dev with `npm run dev` + uvicorn (not needed on Vercel or with `vercel dev`) ---
# Where Next.js proxies /api/* to (server-side only, origin with no path).
API_ORIGIN=http://localhost:8000
# Browser origins allowed to call the API cross-origin (comma-separated), and a regex form.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN_REGEX=

# --- Behaviour ---
# Require applicants to confirm their email before submitting.
REQUIRE_EMAIL_VERIFICATION=true
# Optional: canonical site URL for social previews.
# NEXT_PUBLIC_SITE_URL=https://arewarevivalproject.org
