# Not needed in the deployment (tests and the Docker fallback run in CI only).
# Ignoring the Dockerfile also keeps Vercel from treating the API as a container service.
backend/.venv
backend/tests
backend/.pytest_cache
backend/.ruff_cache
backend/.coverage
backend/.env
backend/Dockerfile
backend/.dockerignore
**/__pycache__
frontend/node_modules
frontend/.next
frontend/.env.local
.env.local
