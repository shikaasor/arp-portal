# Supabase project settings → API. The service-role key is a SECRET: backend only, never commit.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
SUPABASE_STORAGE_BUCKET=applicant-documents

# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000
# Optional regex for direct (non-proxied) calls from preview deploys, e.g. ^https://arp-portal-.*\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# Require applicants to confirm their email before submitting.
REQUIRE_EMAIL_VERIFICATION=true
