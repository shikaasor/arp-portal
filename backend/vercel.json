{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "app/**",
      "excludeFiles": "{tests/**,.venv/**,**/__pycache__/**,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
